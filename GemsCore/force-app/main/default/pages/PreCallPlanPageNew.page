                            <apex:repeat value="{!lstTaskModel}" var="tskmd">
                                <tr class="dataRow">
                                    <td width="5%" class="dataCell"> {!tskRow}</td>
                                    <td class="dataCell"> <apex:inputTextarea value="{!tskmd.taskSubject}" rows="1" cols="80"/></td>
                                    <td class="dataCell"> <apex:inputField value="{!tskmd.taskObj.ActivityDate}"/></td>
                                    <td class="dataCell"> <apex:inputField value="{!tskmd.taskObj.Status}"/></td>
                                    <td class="dataCell"> <apex:inputField value="{!tskmd.taskObj.OwnerId}"/> </td>
                                    <td class="dataCell"> <apex:inputField value="{!tskmd.taskObj.description}"/> </td>
                                </tr>    
                                <apex:variable value="{!tskRow+1}" var="tskRow"/>
                            </apex:repeat>              
                        </table>    
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!if(isNewTask == 'false', true, false)}">
                        <table id="keyactions" width="100%" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:20px;font-family:Arial;" class="list">
                            <tr class="headerRow">
                                <td colspan="7" style="background-color:#cde0ff;text-align:center;font-size:14px;font-weight:bold;">Key Actions</td>
                            </tr>
                            <tr class="headerRow">
                                <th class="headerRow"> &nbsp; </th>
                                <th class="headerRow"> &nbsp; </th>
                                <th class="headerRow"> Subject </th>
                                <th class="headerRow"> Due Date </th>
                                <th class="headerRow"> Status </th>
                                <th class="headerRow"> Assign To </th>
                                <th class="headerRow"> Description </th>
                            </tr>
                            <apex:variable var="tskR" value="{!1}"/>
                            <apex:repeat value="{!preCallPlan.Tasks}" var="tsk">
                                <tr class="dataRow">
                                    <td class="dataCell" width="5%"> <a href="#" onclick="actForRemoveTask('{!tsk.id}');return false;"> Remove </a></td>
                                    <td class="dataCell" width="5%" align="center"> {!tskR} <!-- <apex:outputField value="{!obj.Name}"/> --> </td>
                                    <td class="dataCell"> <a href="/{!tsk.id}" target="_blank"> <apex:outputField value="{!tsk.Subject}"/> </a></td>
                                    <td class="dataCell"> <apex:outputField value="{!tsk.ActivityDate}"/></td>
                                    <td class="dataCell"> <apex:outputField value="{!tsk.Status}"/></td>
                                    <td class="dataCell"> <apex:outputField value="{!tsk.OwnerId}"/></td>
                                    <td class="dataCell"> <apex:outputField value="{!tsk.Description}"/></td>
                                </tr>
                                <apex:variable var="tskR" value="{!tskR+1}"/>
                            </apex:repeat>
                        </table>
                    </apex:outputPanel> 
                    <table class="list">
                        <tr class="dataRow">
                            <td class="dataCell"> 
                                <apex:commandButton value="Add/Edit" onClick="actForAddingNewTask('true');return false;"  /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                <apex:commandButton value="Save" onClick="actForSavingNewTask('false');return false;"  /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                <apex:commandButton value="Cancel" onclick="actForCancelNewTask('false');return false;"  />
                            </td>
                        </tr>  
                    </table>
                </apex:outputPanel>
                <!-- Other Key Section (Task) Section End -->
            </apex:pageBlock>
         
            
            <!-- OrgChart Section --> 
            <apex:actionStatus id="orgStatus">
                <apex:facet name="start">
                    <div style="width: 500px;">
                        <img src="/img/loading24.gif" style="vertical-align:middle;margin-left:50px;"/>
                        <span style="margin-left:10px; font-size: 12px; font-weight: bold; color: #000000;">Please Wait...............</span>
                    </div>
                </apex:facet>
            </apex:actionStatus>
            <style>
                div.orgChart div.node {
                    box-shadow: 0px 0px 10px 1px #5E5E5E;
                }
                .mylink:hover {
                    text-decoration: underline;
                    color: #015ba7;
                    BACKGROUND-COLOR: rgb(252, 252, 252);
                    font-weight: 700;
                }
            </style>
            <apex:pageBlock id="orgchart">
                <apex:pageBlockSection collapsible="true" columns="1" title="Org Chart" id="orgChartSec">
                <apex:pageblockSectionItem >
                    <apex:outputPanel layout="none">
                        <apex:commandLink value="Build Org Chart" onclick="openReportsToBox('open');return false;"/> &nbsp; &nbsp;
                        <apex:commandLink value="New Contact" onclick="openNewContactBox('open');return false;"/>
                        <!--Commented one line here and added on line after it BY VISHNU-->
                        <!----<div id="orgChartContainer" style="  margin-left: -4px;background-color: rgb(248, 248, 248) !important;width: 100% !important;margin-top: 5px !important;">-->
                        <div id="orgChartContainer" style="  margin-left: -4px;background-color: rgb(248, 248, 248) !important;width: 1080px !important;margin-top: 5px !important;overflow: scroll;">
                              <div id="orgChart" style="background-color: rgb(248, 248, 248);margin: 0px;"></div>
                        </div>
                    </apex:outputPanel>
                </apex:pageblockSectionItem>
                </apex:pageBlockSection>
            </apex:pageBlock>

            <!-- Link Section Start -->
            <table class="list" width="100%" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:0px;font-family:Arial;">
                <tr class="dataRow" >
                    <td class="dataCell" valign="middle"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <a href="{!linkToReport}" target="_blank" style="font-size:14pt;">  Link to a Business Object Report </a>  </td>
                </tr>
                
            </table>
            <!-- Link Section End -->
            
        </apex:outputPanel>
        
        <!-- Contact Dialog Start --> 
        <div id="divConBox" style="background-color:silver;">
            <apex:pageBlock id="outConDiv" >
                <apex:pageBlockSection title="Customer Contact" columns="1" collapsible="false">
                    <apex:pageblockSectionItem >
                        <apex:pageBlockTable value="{!lstConModel}" var="m" >
                            <apex:column headerValue="Select">
                                <apex:inputCheckbox value="{!m.flg}"/>
                            </apex:column>
                            <apex:column headerValue="Title" value="{!m.conObj.Title}"/>
                            <apex:column headerValue="Name" value="{!m.conObj.Name}"/>
                            <apex:column headerValue="Reports To" value="{!m.conObj.ReportsTo.Name}"/>
                            <apex:column headerValue="Email" value="{!m.conObj.Email}"/>
                        </apex:pageBlockTable>
                    </apex:pageblockSectionItem>
                </apex:pageblockSection>
                
                <apex:pageBlockSection title="Gems Contact" columns="1" collapsible="false">
                    <apex:pageblockSectionItem >
                        <apex:pageBlockTable value="{!gemsUsrList}" var="gemusr" >
                            <apex:column headerValue="Select">
                                <apex:inputCheckbox value="{!gemusr.isChecked}"/>
                            </apex:column>
                            <apex:column headerValue="Title" value="{!gemusr.usrObj.Title}"/>
                            <apex:column headerValue="Name" value="{!gemusr.usrObj.Name}"/>
                            <apex:column headerValue="Email" value="{!gemusr.usrObj.Email}"/>
                        </apex:pageBlockTable>
                    </apex:pageblockSectionItem>
                </apex:pageblockSection>
                <apex:pageBlockButtons >
                    <apex:commandButton value="Add To Pre-Call Plan" onclick="actForCloseContactBox('false');return false;"/> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                     <apex:commandButton value="Cancel" onclick="openBox('close');return false;"/>
                </apex:pageBlockButtons>
            </apex:pageBlock>
        </div>
        <!-- Contact Dialog End -->
        
        <!-- Trip Report Dialog Start --> 
        <div id="divTripReportBox" style="background-color:silver;">
            <apex:pageBlock id="outTripReport">
                <apex:pageBlockButtons location="top">
                    <apex:commandButton value="Print Pdf" action="{!openPDFPage}" reRender="outFun" oncomplete="openPDFButton();"/>
                    <apex:commandButton value="Print Doc" action="{!openPDFPage}" reRender="outFun" oncomplete="openMsDocButton();"/>
                    
                    <apex:commandButton value="Cancel" />
                </apex:pageBlockButtons>
                
                <apex:pageBlockTable value="{!lstTripReportModel}" var="tpr">
                    <apex:column headerValue="">
                        <apex:inputCheckbox value="{!tpr.isShow}"/>
                    </apex:column>
                    <apex:column value="{!tpr.sectionName}" headerValue="Section Name"/>
                </apex:pageBlockTable> 
               
            </apex:pageBlock>
            
        </div> 
        
        <!-- ReportsTo  Dialog Start --> 
        <div id="divReportToBox" style="background-color:silver;">
            <apex:pageBlock id="outReportToBox">
                <apex:pageBlockButtons location="top">
                    <apex:commandButton value="Save" onclick="openReportsToBox('close');return false;" />
                    <apex:commandButton value="Cancel" onclick="openReportsToBox('close');return false;"/>
                </apex:pageBlockButtons>
                
                <apex:pageBlockTable value="{!lstreportToModel}" var="rpt">
                    <apex:column headerValue="Contact Name" value="{!rpt.conObj.Name}"/>    
                    <apex:column headerValue="Job Title" value="{!rpt.conObj.Title}"/>
                    <apex:column headerValue="Reports To">
                        <apex:selectList value="{!rpt.reportsToId}" size="1" multiselect="false">
                            <apex:selectOptions value="{!lstReportsToContact}"></apex:selectOptions>
                        </apex:selectList>
                    </apex:column>
                    <apex:column headerValue="DMU" >
                        <apex:selectList value="{!rpt.conObj.DMU__c}" size="1" multiselect="false">
                            <apex:selectOptions value="{!lstDMUSelOpt}"></apex:selectOptions>
                        </apex:selectList>
                    </apex:column>
                </apex:pageBlockTable> 
               
            </apex:pageBlock>
            
        </div> 
        
        <!-- New Contact Dialog Start --> 
        <div id="divNewContactBox" style="background-color:silver;">
            <apex:pageBlock id="outNewContactBox">
                <apex:pageBlockButtons location="top">
                    <apex:commandButton value="Save" onclick="openNewContactBox('close');return false;"/>
                    <apex:commandButton value="Cancel" onclick="openNewContactBox('close');return false;"/>
                </apex:pageBlockButtons>
                <table class="list">
                    <tr class="dataRow">
                        <td class="headerRow"> First Name </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.FirstName}"/> </td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Last Name </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.LastName}"/> </td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Phone </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.Phone}"/> </td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Email </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.Email}"/></td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Job Title </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.title}"/> </td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Bussines Unit </td>                        
                        <td class="dataRow"> <apex:inputField value="{!newConObj.Business_Unit__c}" style="width: 142px;"/> </td>
                    </tr>
                    <tr class="dataRow">
                        <td class="headerRow"> Reports To </td>                        
                        <td class="dataRow">
                            <apex:selectList value="{!newConObj.ReportsToId}" size="1" multiselect="false"> 
                                <apex:selectOptions value="{!lstReportsToContact}"></apex:selectOptions> 
                            </apex:selectList>
                        </td>
                    </tr>                    
                    <tr class="dataRow">
                        <td class="headerRow">DMU</td>                        
                        <td class="dataRow"><apex:inputField value="{!newConObj.DMU__c }" style="width: 142px;"/> </td>
                    </tr>
                </table>
            </apex:pageBlock>
            
        </div>
    </apex:form>
    <!-- For Org Chart ---> 
    <!-- <apex:includeScript value="{!URLFOR($Resource.OrgChart,'OrgChart/jquery-1.11.1.min.js')}"/> -->
    <apex:includeScript value="{!URLFOR($Resource.OrgChart,'OrgChart/jquery.orgchart.js')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.OrgChart,'/OrgChart/jquery.orgchart.css')}"/>
    <script src="{!URLFOR($Resource.oppjsonmaster,'jsonmaster/json2.js')}"></script>  
    <apex:outputPanel id="orgChartData">
        <script>
            var testData = JSON.parse('{!JSENCODE(orgChartDataInJson)}');
            $(function(){
            org_chart = $('#orgChart').orgChart({
                data: testData,
                showControls: false,
                allowEdit: false,
            });
        });
        </script>
    </apex:outputPanel>
</apex:page>