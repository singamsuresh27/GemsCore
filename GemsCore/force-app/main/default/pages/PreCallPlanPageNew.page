<apex:page standardController="Percall_Plan__c" docType="html-5.0" extensions="PreCallPlanController" cache="true" standardStylesheets="true" sidebar="true" showHeader="true" id="pg">
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=7,IE=8,IE=9,IE=10,IE=11,IE=Edge" />
    
    
    <apex:includeScript value="{!URLFOR($Resource.JDialog,'JDialog/js/jquery-1.9.1.js')}"/>
    <apex:includeScript value="{!URLFOR($Resource.JDialog,'JDialog/js/jquery-ui-1.10.3.custom.js')}"/> 
    
    <apex:stylesheet value="{!URLFOR($Resource.JDialog,'/JDialog/css/sunny/jquery-ui-1.10.3.custom.css')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.JDialog,'/JDialog/css/sunny/jquery-ui-1.10.3.custom.min.css')}"/>
    <apex:stylesheet value="{!URLFOR($Resource.JDialog,'/JDialog/development-bundle/themes/sunny/jquery.ui.all.css')}"/>
    
    <style>
        #orgChart{
            width: auto;
            height: auto;
        }
        
        div.orgChart div.node{
            width: 100px;
            height: 30px;    
        }
        
        div.orgChart h2 {
            font-size: 12px;
            font-weight: normal;
        }
        #orgChartContainer{
            width: 1000px;
            height: 500px;
            margin-left:10px;
            overflow: auto;
            background: #eeeeee;
        }
        .node{
            padding:0px !important;
        }
        .ui-timepicker-container{
            width: 116px !important;
        }
        .ui-timepicker-viewport{
            padding-right:0px !important;
        }
        .ui-menu-item{
            width: 80px !important;
        }
    </style>
    <script>
        window.onload = function(){
            document.getElementById('printBtnDiv').focus();
        }
        
         $(function(){            
            if( '{!preCallPlan.Convert_to_Post_Call__c}' == 'true'){
                convertPostCall(true);
            }else{
                convertPostCall(false);
            }
            
            if(document.getElementById("img_pg:frm:orgchart:orgChartSec") != null ){
                twistSection(document.getElementById("img_pg:frm:orgchart:orgChartSec"));
            }
            
            var dlg = $( "#divConBox" ).dialog({
               autoOpen:false,
               width:900,
               title:'Select Contact',
               height:600
            });
            
            dlg.parent().appendTo("#pg\\:frm");
            
            var dlgTripReport = $( "#divTripReportBox" ).dialog({
               autoOpen:false,
               width:600,
               title:'Select Sections To Print',
               height:400
            });
            
            dlgTripReport.parent().appendTo("#pg\\:frm");
            
            var dlgReportTo = $( "#divReportToBox" ).dialog({
               autoOpen:false,
               width:700,
               title:'Change Contact ReportsTo Setting',
               height:600
            });
            
            dlgReportTo.parent().appendTo("#pg\\:frm");
            
            var dlgNewContact = $( "#divNewContactBox" ).dialog({
               autoOpen:false,
               width:700,
               title:'New Contact',
               height:400
            });
            
            dlgNewContact.parent().appendTo("#pg\\:frm");
            $("[id='pg\\:frm:pbTripSummery']").css('border-top','3px solid green');
            $("[id='pg\\:frm:pbTask']").css('border-top','3px solid green');
        });
        
             
           
        function openBox(st){
            $( "#divConBox" ).dialog(st);
        }
        
        function openTripReportBox(st){
            $( "#divTripReportBox").dialog(st);
        }
        
        function openReportsToBox(st){
            $( "#divReportToBox").dialog(st); 
            if(st == 'close'){
                actUpdateOrgChartSection();
            }   
        }
        
        function openNewContactBox(st){
            $( "#divNewContactBox").dialog(st);
            if(st == 'close'){
                actCreateandUpdateOrgChartSection();
            }
        }  
        function convertPostCall(flag){
            if( document.getElementById("pg:frm:pbTripSummery:tripsummary") != null ){
                if(flag){
                    document.getElementById("pg:frm:pbTripSummery:tripsummary").style.display = 'block';
                    document.getElementById("pg:frm:pbTripSummery:pbTask").style.display = 'block';
                }else{
                    document.getElementById("pg:frm:pbTripSummery:tripsummary").style.display = 'none';
                    document.getElementById("pg:frm:pbTripSummery:pbTask").style.display = 'none';
                }
            }
        }
       </script>

       <apex:outputPanel id="outFun">
           <script>
            function openMsDocButton(){            
                var myurl = "/apex/PreCallPlanMsDocPage?id={!preCallPlan.id }&sectnames={!sections}" ;
                $( "#divTripReportBox").dialog('close');
                var win = window.open(myurl,'_blank');
                win.focus();
            } 
            
            function openPDFButton(){
            
                var myurl = "/apex/PreCallPlanPDFPage?id={!preCallPlan.id }&sectnames={!sections}" ;
                $( "#divTripReportBox").dialog('close');
                var win = window.open(myurl,'_blank');
                win.focus();
            } 
           </script>
       </apex:outputPanel>
    
    <apex:form id="frm">
        <apex:pageMessages ></apex:pageMessages>
        <apex:actionFunction name="actCreateandUpdateOrgChartSection" status="orgStatus" action="{!saveNewContact}" rerender="orgchart,outReportToBox,orgChartData,outConDiv,outNewContactBox"/>
        <apex:actionFunction name="actUpdateOrgChartSection" status="orgStatus" action="{!saveReportsToSetting}" rerender="orgchart,outReportToBox,orgChartData"/>
        <apex:actionFunction name="actOpenAccount" action="{!openAccount}"/>
        <apex:actionFunction name="actOpenOpportunity" action="{!openOpportunity}"/>
        <apex:actionFunction name="actOpenPreCallPlan" action="{!openPreCallPlan}"/>
        <apex:actionFunction name="actSaveContactFromList" action="{!saveContact}"/>
        <apex:actionFunction name="actForCloseContactBox" action="{!justCalling}" status="conStatus" reRender="pbcon,outConDiv" oncomplete="actSaveContactFromList();">
            <apex:param name="p1" value="" assignTo="{!isNewPreCallPlanContact}"/>
        </apex:actionFunction>
                
        <apex:actionFunction name="actRemoveContact" action="{!removeContact}" />
        <apex:actionFunction name="actForRemoveContact" action="{!justCalling}" status="conStatus" oncomplete="actRemoveContact();">
            <apex:param name="p1" value="" assignTo="{!preCallPlanContactId}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actRemoveCallObjective" action="{!removeCallObjective}" />
        <apex:actionFunction name="actForRemoveObjective" action="{!justCalling}"  status="callStatus" oncomplete="actRemoveCallObjective();">
            <apex:param name="p1" value="" assignTo="{!callObjectiveId}" />
        </apex:actionFunction>
        
        <apex:actionFunction name="actRemoveQuestion" action="{!removeQuestion}" />
        <apex:actionFunction name="actForRemoveQuestion" action="{!justCalling}"  status="QuestionsStatus" oncomplete="actRemoveQuestion();">
            <apex:param name="p1" value="" assignTo="{!questionId}" />
        </apex:actionFunction>
        
        <apex:actionFunction name="actRemoveObjection" action="{!removeObjection}" />
        <apex:actionFunction name="actForRemoveObjection" action="{!justCalling}"  status="objectionStatus" oncomplete="actRemoveObjection();">
            <apex:param name="p1" value="" assignTo="{!objectionId}" />
        </apex:actionFunction>
        
        <apex:actionFunction name="actRemoveTask" action="{!removeTask}" />
        <apex:actionFunction name="actForRemoveTask" action="{!justCalling}"  status="taskStatus" oncomplete="actRemoveTask();">
            <apex:param name="p1" value="" assignTo="{!taskId}" />
        </apex:actionFunction>
        
        <!-- Action Functions For Contact Part --> 
        <apex:actionFunction name="actAddingMore" action="{!addingMorePreCallPlanContactModel}" status="conStatus" reRender="pbcon"/>
        <apex:actionFunction name="actSavePrePlanContact" action="{!savePreCallPlanContact}" status="conStatus" reRender="pbcon,outConDiv,orgchart,orgChartData"/>
        <apex:actionFunction name="actCancelContact" action="{!cancelMoreContact}" status="conStatus" reRender="pbcon"/>
        <apex:actionFunction name="actForAddingNewContact" action="{!justCalling}" status="conStatus" rerender="pbcon" oncomplete="actAddingMore();">
            <apex:param name="pr1" value="" assignTo="{!isNewPreCallPlanContact}"/>           
        </apex:actionFunction>
        
        <apex:actionFunction name="actSavingNewContact" action="{!justCalling}"  status="conStatus" rerender="pbcon" oncomplete="actSavePrePlanContact();">
            <apex:param name="pr2" value="" assignTo="{!isNewPreCallPlanContact}"/>
             
        </apex:actionFunction>
        
        <apex:actionFunction name="actCancelNewContact" action="{!justCalling}" status="conStatus" rerender="pbcon" oncomplete="actCancelContact();">
            <apex:param name="pr3" value="" assignTo="{!isNewPreCallPlanContact}"/>
        </apex:actionFunction>
        
        
        <!-- Action Functions for Call Objective Part --> 
        <apex:actionFunction name="actAddingMoreCallObj" action="{!addingMoreCallObjectiveModel}" status="callStatus" reRender="pbCallObj"/>       
        <apex:actionFunction name="actSaveCallObjective" action="{!saveCallObjectives}" status="callStatus" reRender="pbCallObj"/>
        <apex:actionFunction name="actCancelObjective" action="{!cancelMoreObjective}" status="callStatus" reRender="pbCallObj"/>                
        <apex:actionFunction name="actForNewCallObjective" action="{!justCalling}" status="callStatus" reRender="pbCallObj" oncomplete="actAddingMoreCallObj();">
            <apex:param name="cl1" value="" assignTo="{!isNewCallObjective}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForSavingCallObjective" action="{!justCalling}"  status="callStatus" rerender="pbCallObj" oncomplete="actSaveCallObjective();">
            <apex:param name="cl2" value="" assignTo="{!isNewCallObjective}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForCancelCallObjective" action="{!justCalling}" status="callStatus" rerender="pbCallObj" oncomplete="actCancelObjective();">
            <apex:param name="cl3" value="" assignTo="{!isNewCallObjective}"/>
        </apex:actionFunction>
        
        <!-- Action Functions for Questions Part -->
        <apex:actionFunction name="actAddingMoreQuestion" action="{!addingMoreQuestions}" status="QuestionsStatus" reRender="pbqstObj"/>
        <apex:actionFunction name="actSavingQuestions" action="{!saveKeyQuestions}" status="QuestionsStatus" reRender="pbqstObj"/>
        <apex:actionFunction name="actCancelQuestion" action="{!cancelMoreQuestions}" status="QuestionsStatus" reRender="pbqstObj" />
        <apex:actionFunction name="actForAddingNewQuestion" action="{!justCalling}" status="QuestionsStatus" reRender="pbqstObj" oncomplete="actAddingMoreQuestion();">
            <apex:param name="qs1" value="" assignTo="{!isNewQuestion}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForSavingNewQuestion" action="{!justCalling}" status="QuestionsStatus" reRender="pbqstObj" oncomplete="actSavingQuestions();">
            <apex:param name="qs2" value="" assignTo="{!isNewQuestion}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForCancelNewQuestion" action="{!justCalling}" status="QuestionsStatus" reRender="pbqstObj" oncomplete="actCancelQuestion();">
            <apex:param name="qs3" value="" assignTo="{!isNewQuestion}"/>
        </apex:actionFunction>
                
        <!-- Action Functions for Objections Part -->   
        <apex:actionFunction name="actAddingMoreObjections" action="{!addingMoreObjections}" status="objectionStatus" reRender="pbobjetObj" />
        <apex:actionFunction name="actSavingObjections" action="{!saveObjections}" status="objectionStatus" reRender="pbobjetObj" />
        <apex:actionFunction name="actCancelObjection" action="{!cancelMoreObjection}" status="objectionStatus" reRender="pbobjetObj"/>
        <apex:actionFunction name="actForAddingNewObjection" action="{!justCalling}" status="objectionStatus" reRender="pbobjetObj" oncomplete="actAddingMoreObjections();">
            <apex:param name="objet1" value="" assignTo="{!isNewObjection}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForSavingNewObjection" action="{!justCalling}" status="objectionStatus" reRender="pbobjetObj" oncomplete="actSavingObjections();">
            <apex:param name="objet2" value="" assignTo="{!isNewObjection}"/>
        </apex:actionFunction>
        
        <apex:actionFunction name="actForCancelNewObjection" action="{!justCalling}" status="objectionStatus" reRender="pbobjetObj"  oncomplete="actCancelObjection();">
            <apex:param name="objet3" value="" assignTo="{!isNewObjection}"/>
        </apex:actionFunction>
        
        
       
        <!-- Action Function for Task Sections -->
          
        <apex:actionFunction name="actAddingMoreTask" action="{!addingMoreTask}"  status="taskStatus" reRender="pbTask"/>
        <apex:actionFunction name="actSaveTask" action="{!saveTask}" status="taskStatus"  reRender="pbTask,pbTripSummery"/>
        <apex:actionFunction name="actCancelTask" action="{!cancelMoreTask}" status="taskStatus"  reRender="pbTask"/>
        <apex:actionFunction name="actForAddingNewTask" action="{!justCalling}" status="taskStatus" reRender="pbTask" oncomplete="actAddingMoreTask();">
            <apex:param name="ts1" value="" assignTo="{!isNewTask}"/>
        </apex:actionFunction> 
        
        <apex:actionFunction name="actForSavingNewTask" action="{!justCalling}" status="taskStatus" reRender="pbTask" oncomplete="actSaveTask();return false;">
            <apex:param name="ts1" value="" assignTo="{!isNewTask}"/>
        </apex:actionFunction>
        <apex:actionFunction name="actForCancelNewTask" action="{!justCalling}" status="taskStatus" reRender="pbTask" oncomplete="actCancelTask();">
            <apex:param name="ts1" value="" assignTo="{!isNewTask}"/>
        </apex:actionFunction>
        
        <div id="printBtnDiv">
            <span style="float:left;"> <apex:commandButton value="Print" onclick="openTripReportBox('open');return false;" rendered="{!isRecordSaved}"/></span> 
        </div>
        <style>
            .dateFormat a{
                color:white !important;
            }
        </style>
        <apex:pageBlock id="pgb">
            <link rel="stylesheet" href="{!URLFOR($Resource.timepicker,'timepicker/jquery.timepicker.min.css')}"/>            
            <script type="text/javascript" src="{!URLFOR($Resource.timepicker,'timepicker/jquery.timepicker.min.js')}"></script>
                        
            <!-- Pre-Plan Section Start -->
                <script>
                    var myVar ;
                    $(document).ready(function(){
                        $('#timedivID').hide();
                        $('input[id*=timepic]').timepicker({ 
                            timeFormat: 'h:mm p' ,                            
                            interval :15,
                            defaultTime : '{!nextVisitTime}'   ,
                            startTime: new Date(0,0,0,15,0,0)                          
                        }); 
                        
                        //Code By Vishnu on 30-9-2015 : Created custom time picker of IE
                        $('input[id*=timepic]').click(function () {
                            copyLIdata();
                            var pos = $("input[id*=timepic]").position();
                            $('.ui-timepicker-container').hide();
                            $('#timedivID').css({
                                top: pos.top + $("input[id*=timepic]").height()  + 3,
                                left: pos.left+10
                            });
                            $('#timedivID').show();    
                        }); 
                        $('.timeDivHide').click(function () {
                              $('#timedivID').hide();    
                        });                   
                    });
                    
                    //Code By Vishnu on 30-9-2015 : Created custom time picker of IE
                    function copyLIdata(){
                        var htmlstr = '<table style="padding: 0;" width="100%">';
                        var lis = document.getElementsByClassName("ui-timepicker-viewport")[0].getElementsByClassName("ui-menu-item");
                        for(var i=0;i<lis.length ; i++){
                            var timeStr = lis[i].getElementsByClassName("ui-corner-all")[0].text;
                            htmlstr +=  '<tr><td align="center" class="mytd"><a style="cursor: pointer;text-decoration: none;" onclick="visitTime(\''+timeStr+'\');return false;">'+timeStr+'</a></td></tr>';
                        }
                        htmlstr += '</table>';
                        $('#timedivID').html(htmlstr);
                    }
                    
                    //Code By Vishnu on 30-9-2015 : Created custom time picker of IE
                    function visitTime(timesr){
                        $('input[id*=timepic]').val(timesr);
                        $('#timedivID').hide();
                    }
                </script>
            <style>
                .dateFormat{
                    display:none !important;
                }
                .ui-menu-item{
                    font-size:10px !important;
                    opacity: 0.0 !important;
                }
                .ui-timepicker-viewport{
                    background-color: white;
                }
                .mytd:Hover{
                    background-color: beige;
                    border-radius: 3px;                    
                }
            </style>
            
            <table  class="list" width="100%" border="1" cellspacing="1" cellpadding="1" align="center"  >
                <tr class="headerRow">
                    <td rowspan="2" width="70%" style="background:#483D8B;font-size:30px;font-weight:bold;text-align:center;color:white;" class="timeDivHide"> Pre-Call Plan </td>
                    <td width="30%" style="background:#483D8B;color:white;">Next Visit Date : &nbsp;&nbsp;&nbsp;&nbsp;
                        <!---<apex:inputField value="{!preCallPlan.Date_of_Visit__c}" rendered="{!!isRecordSaved}"/>--->
                        <apex:outputField value="{!preCallPlan.Date_of_Visit__c}" rendered="{!isRecordSaved}"/>
                        <apex:inputField value="{!conDateOfVisit.birthdate}" rendered="{!!isRecordSaved}"/>
                        <apex:inputText value="{!nextVisitTimeStr}"  id="timepic"   style="width: 75px;margin-left: 10px;" rendered="{!!isRecordSaved}"/>    
                        <div id="timedivID" style="position: absolute;width: 108px;height: 200px;z-index: 10000;background-color: white;overflow: auto;display:none"></div>
                        <!---<apex:input  type="date" value="{!dateOfVisit}" rendered="{!!isRecordSaved}"/>
                        <apex:input type="time" value="{!nextVisitTime}" rendered="{!!isRecordSaved}"/>--->
                    </td>
                </tr>
                <tr class="headerRow timeDivHide">
                    <td width="30%" style="background:#483D8B;color:white;">Last Visit Date: &nbsp;&nbsp;&nbsp;&nbsp;<apex:outputField value="{!preCallPlan.Date_of_last_visit__c}"/></td>
                </tr>            
            </table>
            <!-- Pre-Plan Section End -->
            
            <!-- Customer Section Start -->
            <table class="list timeDivHide" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:0px;font-family:Arial;" >
                <tr class="headerRow">
                    <td class="headerRow" style="font-weight:bold;width:12%;"> Pre-Call Plan Name : </td>
                    <td class="dataCell" style="width:38%;"> <apex:inputField value="{!preCallPlan.Name}" rendered="{!!isRecordSaved}"/> <apex:outputLink value="{!preCallPlan.Name}"  rendered="{!isRecordSaved}" onclick="actOpenPreCallPlan();return false;"> {!preCallPlan.Name}</apex:outputLink></td>   
                    <td class="headerRow" style="font-weight:bold;width:12%;"> Opportunity : </td>
                    <td class="dataCell" style="width:38%;"> <apex:outputLink onclick="actOpenOpportunity();return false;"> {!if(opp != null, opp.Name, '')}</apex:outputLink>   </td>
                </tr>
                <tr class="headerRow">
                    <td class="headerRow" style="font-weight:bold;width:12%;"> Customer : </td>
                    <td class="dataCell" style="width:38%;"> <!-- <apex:inputField value="{!preCallPlan.Account__c}" rendered="{!!isRecordSaved}"/> <apex:outputField value="{!preCallPlan.Account__c}" rendered="{!isRecordSaved}"/> --> <apex:outputLink value="{!acc.Name}" onclick="actOpenAccount();return false;" >{!acc.Name} </apex:outputLink>   </td>
                    <td class="headerRow" style="font-weight:bold;width:12%;" > Address : <!-- &nbsp;&nbsp; <span> {!acc.shippingStreet}, {!acc.shippingCity},  {!acc.shippingState}  </span> --></td>
                    <td class="dataCell" style="width:38%;"> {!acc.shippingStreet}, {!acc.shippingCity},  {!acc.shippingState} </td> 
                </tr>
                <tr class="headerRow">
                    <td class="headerRow" style="font-weight:bold;width:12%;"> Meeting Address : </td>
                    <td class="dataCell" style="width:38%;"> 
                        <apex:inputField value="{!preCallPlan.Meeting_Address__c}" rendered="{!!isRecordSaved}"/> 
                        <apex:outputField value="{!preCallPlan.Meeting_Address__c}" rendered="{!isRecordSaved}"/>
                    </td>
                    <td class="headerRow" style="font-weight:bold;width:12%;" > Owner : </td>
                    <td class="dataCell" style="width:38%;"> <apex:outputField value="{!preCallPlan.account__r.ownerid}"/> </td> 
                </tr>
            </table>
            <!-- Customer Section End -->
            
            <!-- Account Overview Section Start -->
            <table width="75%" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:0px;font-family:Arial;" class="list timeDivHide" >
                <tr class="headerRow">
                    <td class="headerRow" style="background-color:#cde0ff;text-align:center;font-size:14px;font-weight:bold;"> Account Overview </td>
                </tr>
                <tr class="dataRow">
                    <td class="dataCell"> <apex:inputField value="{!acc.Description}" style="width:98%;" rendered="{!!isRecordSaved}"/> <apex:outputField value="{!acc.Description}" rendered="{!isRecordSaved}"/></td>
                </tr>
            </table>    
            <!-- Account Overview Section End -->
            
            <!-- Situation  Update Section Start -->
            <table width="75%" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:0px;font-family:Arial;" class="list timeDivHide" >
                <tr class="headerRow">
                    <td class="headerRow" style="background-color:#cde0ff;text-align:center;font-size:14px;font-weight:bold;"> Situation  Update </td>
                </tr>
                <tr class="dataRow">
                    <td class="dataCell"> 
                        <apex:inputTextarea rows="5" richText="true" value="{!preCallPlan.Situation_Update__c}" style="width:98%;" rendered="{!!isRecordSaved}"/> 
                        <apex:outputField value="{!preCallPlan.Situation_Update__c}" rendered="{!isRecordSaved}"/>
                    </td>
                </tr>
            </table>    
            <!-- Situation  Update Section End -->
            

            
            <apex:outputPanel id="outButtonPanel" > 
            <table width="75%" border="0" align="center">
                <tr>
                    <td align="center"> <apex:commandButton value="Edit" action="{!editPreCallPlan}" style="width:100px;height:25px;font-size:10pt;" rendered="{!isRecordSaved}"/> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<apex:commandButton value="Save" action="{!savePreCallPlan}" rendered="{!!isRecordSaved}" style="width:100px;height:25px;font-size:10pt;"/> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <apex:commandButton value="Cancel" action="{!cancelPage}" style="width:100px;height:25px;font-size:10pt;"/></td>
                </tr>
            </table>
            </apex:outputPanel>

            <!-- Funnel Section Start -->
            <apex:outputPanel id="outDownPanelFunnel" rendered="{!isRecordSaved}"> 
                <apex:outputPanel id="funnelpanle" >   <!--rendered="{!if(isNewPreCallPlanContact == 'false', true, false)}"-->                     
                    <table width="75%" border="1" cellspacing="1" cellpadding="1" align="center" style="margin-top:0px;font-family:Arial;" class="list">
                        <tr class="headerRow">
                            <td colspan="8" style="background-color:#cde0ff;text-align:center;font-size:14px;font-weight:bold;"> Funnel </td>
                        </tr>
                        <tr class="headerRow">
                            <th class="headerRow">
                                <apex:actionStatus id="funstatus">        
                                    <apex:facet name="start">
                                        <div style="width: 20px;">
                                            <img src="/img/loading24.gif" style="vertical-align:middle;margin-left: 3px;height: 16px;"/>
                                        </div>
                                    </apex:facet>
                                </apex:actionStatus>
                            </th>
                            <apex:repeat value="{!lstOppFields}" var="oph">                        
                                <th class="headerRow"> {!oph}</th>
                            </apex:repeat>
                        </tr>
                        <apex:repeat value="{!oppModelList}" var="op">
                            <tr class="dataRow">
                                <td class="dataCell"><apex:inputCheckbox disabled="{!!isFunnelEdit}" value="{!op.isChecked}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.Opportunity_Number__c}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.Name}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.Estimated_Amount__c}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.StageName}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.Product_Model__c}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.NextStep}"/></td>
                                <td class="dataCell"><apex:outputField value="{!op.oppObj.CloseDate}"/></td>
                            </tr>
                        </apex:repeat>
                        <tr>
                            <td colspan="8" >
                                <apex:commandButton value="Edit" action="{!goToEditForFunnel}" rendered="{!!isFunnelEdit}" reRender="funnelpanle" status="funstatus"/>
                                <apex:commandButton value="Save" action="{!saveFunnelOpp}" rendered="{!isFunnelEdit}"  reRender="funnelpanle" status="funstatus"/>
                                <apex:commandButton value="Cancel" action="{!initForFunnel}" rendered="{!isFunnelEdit}" reRender="funnelpanle" status="funstatus" style="margin-left: 25px;"/>
                            </td>
                        </tr>
                    </table> 
                </apex:outputPanel>  
            </apex:outputPanel> 
