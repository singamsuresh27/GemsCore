                        </apex:repeat>
                    </table>    
                </apex:outputPanel>
                <table class="list">
                    <tr class="dataRow">
                            <td class="dataCell"> 
                                <apex:commandButton value="Add/Edit" onclick="actForAddingNewObjection('true');return false;"  />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                <apex:commandButton value="Save" onclick="actForSavingNewObjection('false');return false;" /> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                                <apex:commandButton value="Cancel" onclick="actForCancelNewObjection('false');return false;"  />
                            </td>
                    </tr> 
