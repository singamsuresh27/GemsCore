                            <b style="background: #483D8B;font-size: 15px;">
                            <apex:inputCheckbox id="convertpostcall" rendered="{!!preCallPlan.Convert_to_Post_Call__c}" onclick="convertPostCall(this.checked);" value="{!preCallPlan.Convert_to_Post_Call__c}"/> 
                            <apex:inputCheckbox disabled="true" rendered="{!preCallPlan.Convert_to_Post_Call__c}" value="{!preCallPlan.Convert_to_Post_Call__c}"/> 
                            Convert to Post Call
                            </b>
                            <b style="background:#483D8B;font-size:30px;margin-left: 20%;">Post-Call Summary</b>
                        </td>                        
                    </tr>           
                </table>
