                    </Table>
                    <Table id="tbl8" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr>
                            <td class="text1"><b>Evaluate By:</b> <apex:outputField value="{!Case_Detail__c.Escalated_To__r.FirstName}"/> <apex:outputField value="{!Case_Detail__c.Escalated_To__r.LastName }"/>   </td>
                            <td class="text1"><b>Completion Date:</b> <apex:outputField value="{!Case_Detail__c.Date_Evaluation_Completed__c}"/>  </td>
                        </tr>

                    </Table>                    
