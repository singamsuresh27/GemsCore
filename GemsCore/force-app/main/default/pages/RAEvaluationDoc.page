                            <td class="text1"><b><u>Customer Ref #:</u></b> <apex:outputField value="{!Case_Detail__c.Case__r.Customer_Internal_Case_RA_No__c}"/></td>
                        </tr>
                    </Table>
                    <Table id="tbl3" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr>
                            <td class="text1" colspan="5"><b><u>Product Information:</u></b></td>
                        </tr>
                         <tr>
                            <td class="text1"><b>Qty</b></td>
                            <td class="text1"><b>Gems P/N</b></td>
                            <td class="text1"><b>Date Code/Serial number</b></td>
                            <td class="text1"><b>Customer Part#</b></td>
                            <td class="text1"><b>Model/Extended Description</b></td>
                        </tr>
                         <tr>
                            <td class="text1"><apex:outputField value="{!Case_Detail__c.Quantity__c}"/></td>
                            <td class="text1"><apex:outputField value="{!Case_Detail__c.Order_Shipment__r.Productid__r.ProductCode}"/></td>
                            <td class="text1"><apex:outputField value="{!Case_Detail__c.Date_Code_Serial_No__c}"/></td>
                            <td class="text1"><apex:outputField value="{!Case_Detail__c.Case__r.Customer_Part_Number__c}"/></td>
                            <td class="text1"><apex:outputField value="{!Case_Detail__c.Order_Shipment__r.Productid__r.Description}"/></td>
                        </tr>
                    </Table>
                    <Table id="tbl4" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr><td class="text1" ><b><u>Customer Observation:</u></b></td></tr>
                        <tr><td class="text1"><apex:outputField value="{!Case_Detail__c.Case__r.Description}"/></td></tr>
                    </Table>
                    <Table id="tbl5" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr><td class="text1" ><b><u>Evaluation:</u></b></td></tr>
                        <tr><td class="text1"><apex:outputField value="{!Case_Detail__c.Receivers_Comment__c}"/></td></tr>
                        <tr><td class="text1"><apex:outputField value="{!Case_Detail__c.Warranty_Type__c}"/></td></tr>
                    </Table>
                    
                     <apex:outputLabel rendered="{!IF(Case_Detail__c.Engineering_Comment__c != NULL, true, false)}">
                    <Table id="tbl10" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr><td class="text1"><b><u>  Detailed Evaluation:  </u></b></td></tr>
                        <tr><td class="text1"><apex:outputField rendered="{!IF(Case_Detail__c.Engineering_Comment__c != NULL, true, false)}" value="{!Case_Detail__c.Engineering_Comment__c}"/></td></tr>
                    </Table> 
                    </apex:outputLabel>                                    
                    
                    <Table id="tbl6" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr><td class="text1"><b><u>Recommendation:</u></b></td></tr>
