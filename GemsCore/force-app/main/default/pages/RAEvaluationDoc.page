                <tr><td>                
                    <Table id="tbl2" cellSpacing="1" cellPadding="2" width="100%" align="left" border="1">
                        <tr>
                            <td class="text1"><b><u>RA #:</u></b> <apex:outputField value="{!Case_Detail__c.Name}"/></td>
                            <td class="text1"><b><u>Evaluation Start Date:</u></b> <apex:outputField value="{!Case_Detail__c.Date_Evaluation_Started__c}"/></td>
                            <td class="text1"><b><u>Original PO/SO#:</u></b> <apex:outputField value="{!Case_Detail__c.Order_Shipment__r.PONumber__c}"/></td>
                        </tr>
