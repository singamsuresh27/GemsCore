                            <td class="text1"><b><u>Contact:</u></b>&nbsp; <apex:outputField value="{!Case_Detail__c.Case__r.Contact.FirstName}"/> <apex:outputField value="{!Case_Detail__c.Case__r.Contact.LastName}"/></td>
