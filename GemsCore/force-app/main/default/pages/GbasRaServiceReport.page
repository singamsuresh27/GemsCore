                        </tr>
                    </Table>
                    <Table id="tbl3" cellSpacing="1" cellPadding="2" width="100%" align="center" border="1">
                        <tr>
                            <td   colspan="5"><b><u>Product Information:</u></b></td>
                        </tr>
                         <tr>
                            <td><b>Qty</b></td>
                            <td><b>Gems P/N</b></td>
                            <td><b>Date Code/Serial number</b></td>
                            <td><b>Customer Part#</b></td>
                            <td><b>Model/Extended Description</b></td>
                        </tr>
                         <tr>
                            <td><apex:outputField value="{!Case_Detail__c.Quantity__c}"/></td>
                            <td><apex:outputField value="{!Case_Detail__c.Order_Shipment__r.Productid__r.ProductCode}"/></td>
                            <td><apex:outputField value="{!Case_Detail__c.Date_Code_Serial_No__c}"/></td>
                            <td><apex:outputField value="{!Case_Detail__c.Case__r.Customer_Part_Number__c}"/></td>
                            <td><apex:outputField value="{!Case_Detail__c.Order_Shipment__r.Productid__r.Description}"/></td>
                        </tr>
                    </Table>
                    <Table id="tbl4" cellSpacing="1" cellPadding="2" width="100%" align="center" border="1">
                        <tr><td><b><u>Customer's Fault Symptom/Description:</u></b></td></tr>
                        <tr><td><apex:outputField value="{!Case_Detail__c.Case__r.Description}"/></td></tr>
                    </Table>
                    <Table id="tbl5" cellSpacing="1" cellPadding="2" width="100%" align="center" border="1">
                        <tr><td><b><u>Investigation Analysis:</u></b></td></tr>
                        <tr><td><apex:outputField value="{!Case_Detail__c.Receivers_Comment__c}"/></td></tr>
                        <tr><td><apex:outputField value="{!Case_Detail__c.Warranty_Type__c}"/></td></tr>
                    </Table>
                    <Table id="tbl6" cellSpacing="1" cellPadding="2" width="100%" align="center" border="1">
                        <tr><td><b><u>Recommendation:</u></b></td></tr>
                        <tr><td><apex:outputField value="{!Case_Detail__c.Recommendations__c}"/></td></tr>
                    </Table>
                    <Table id="tbl8" cellSpacing="1" cellPadding="2" width="100%" align="center" border="1">
