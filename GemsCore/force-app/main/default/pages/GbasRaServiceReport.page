                        </tr>
                        <tr>
                            <td><b>Approved By:</b> {!$User.FirstName}  {!$User.LastName}</td>
                            <td><b>Date:</b><apex:outputText value="{0,date,MMMM dd, yyyy}">
                                                <apex:param value="{!TODAY()}" />
                                           </apex:outputText></td>
                        </tr>
                    </Table>                    
