                <TR><TD class="text3" align="Center"><b>Instrument Service Report</b></TD></TR>
                <tr><td>                
                    <Table id="tbl2" cellSpacing="1" cellPadding="2" width="80%" align="center" border="0">
                        <tr>
                            <td class="text1"><b><u>RA #:</u></b>&nbsp; <apex:outputField value="{!Case_Detail__c.Name}"/></td>
                            <td class="text1"><b><u>Evaluation Start Date:</u></b>&nbsp; <apex:outputField value="{!Case_Detail__c.Date_Evaluation_Started__c}"/></td>
