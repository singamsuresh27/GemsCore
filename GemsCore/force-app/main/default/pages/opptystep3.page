<apex:page controller="newOpportunityController" tabStyle="Opportunity">
<script>
function confirmCancel() {
var isCancel = confirm("Are you sure you wish to cancel?");
if (isCancel) return true;
return false;
}
</script>
<apex:sectionHeader title="New Customer Opportunity" subtitle="Step 3 of 3"/>
<apex:form >
<apex:pageBlock title="Confirmation">
<apex:pageBlockButtons >
<apex:commandButton action="{!step2}" value="Previous"/>
<apex:commandButton action="{!save}" value="Save"/>
<apex:commandButton action="{!cancel}" value="Cancel"
onclick="return confirmCancel()" immediate="true"/>
</apex:pageBlockButtons>
<apex:pageBlockSection title="Account Information">
<apex:outputField value="{!account.name}"/>
<apex:outputField value="{!account.Account_Type__c}"/>
<apex:outputField value="{!account.Business_Unite__c}"/>
<apex:outputField value="{!account.Fax}"/>
<apex:outputField value="{!account.Website}"/>
<apex:outputField value="{!account.ShippingStreet}"/>
<apex:outputField value="{!account.ShippingCity}"/>
<apex:outputField value="{!account.ShippingState}"/>
<apex:outputField value="{!account.ShippingPostalCode}"/>
<apex:outputField value="{!account.ShippingCountry}"/>
</apex:pageBlockSection>
<apex:pageBlockSection title="Contact Information">
<apex:outputField value="{!contact.Salutation}"/>
<apex:outputField value="{!contact.Email}"/>
<apex:outputField value="{!contact.lastName}"/>
<apex:outputField value="{!contact.HasOptedOutOfEmail}"/>
<apex:outputField value="{!contact.firstName}"/>
<apex:outputField value="{!contact.phone}"/>
<apex:outputField value="{!contact.Title}"/>
<apex:outputField value="{!contact.MobilePhone}"/>
<apex:outputField value="{!contact.Department}"/>
<apex:outputField value="{!role.role}"/>
</apex:pageBlockSection>
<apex:pageBlockSection title="Opportunity Information">
<apex:outputField value="{!opportunity.name}"/>
<apex:outputField value="{!opportunity.amount}"/>
<apex:outputField value="{!opportunity.closeDate}"/>
<apex:outputField value="{!opportunity.stageName}"/>
<apex:outputField value="{!opportunity.TotalOpportunityQuantity}"/>
<apex:outputField value="{!opportunity.Unit_Price__c}"/>
<apex:outputField value="{!opportunity.Product_Model__c}"/>
<apex:outputField value="{!opportunity.Project_Manager__c}"/>
<apex:outputField value="{!opportunity.Market__c}"/>
<apex:outputField value="{!opportunity.Type}"/>
</apex:pageBlockSection>
</apex:pageBlock>
</apex:form>
</apex:page>