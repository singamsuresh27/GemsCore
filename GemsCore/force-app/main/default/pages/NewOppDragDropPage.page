            function formatNumber(number){        
                number = number.toFixed(2) + '';
                x = number.split('.');
                x1 = x[0];
                x2 = x.length > 1 ? '.' + x[1] : '';
                var rgx = /(\d+)(\d{3})/;
                while (rgx.test(x1)) {
                    x1 = x1.replace(rgx, '$1' + ',' + '$2');
                }
                return x1 + x2;
            }
            
            function compareNumbers(a, b) {
                return a - b;
            }
            
            function compareNumbersd(a, b) {
                return b - a;
            }
            
            var date_sort_asc = function (date1, date2) {
                 if (date1 > date2) return 1;
                 if (date1 < date2) return -1;
                 return 0;
            };
            
            var date_sort_desc = function (date1, date2) {
                if (date1 > date2) return -1;
                if (date1 < date2) return 1;
                return 0;
            }; 
            var dateRE = /^(\d{2})[\/\- ](\d{2})[\/\- ](\d{4})/;
            function mdyOrdA(a, b){
                a = a.replace(dateRE,"$3$1$2");
                b = b.replace(dateRE,"$3$1$2");
                if (a>b) return 1;
                if (a <b) return -1;
                return 0; 
            }
            
            function selectingOption(){
                
                sortfldname = $('#selObj').find(":selected").val();
                //sortfldname = '{!sortingFld}';
                createOpportunitiesContainer();
                createDashboard();
            }
            
            function round(value, decimals) {
                return Number(Math.round(value+'e'+decimals)+'e-'+decimals);
            }
            
            function sortingProcess(jvstr){
                jsonObjArray = [];
                for(var i=0; i<jvstr.length; i++){
                    if(jvstr[i].oppRecord[sortfldname] != undefined){
                        if(sortfldname == 'CloseDate'){
                            jsonObjArray.push(new Date(jvstr[i].oppRecord[sortfldname].replace(/-/g, '/')));     
                        }else{
                            jsonObjArray.push(Number(jvstr[i].oppRecord[sortfldname]));    
                        }     
                    }
                }
                
                // remove duplicate elements
                jsonObjArray=jsonObjArray.unique();
                
                if(sortfldname == 'CloseDate'){
                    jsonObjArray.sort(date_sort_asc);
                }else{
                    jsonObjArray.sort(compareNumbersd);
                }
                
                console.log('----->  Sorted Array '  +  jsonObjArray );
            }
            
        </script>
