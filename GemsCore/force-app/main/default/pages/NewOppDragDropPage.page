            function refreshItem(itemId, oldStageId, newStageId){
                var newStage = (newStageId.trim()).split('-list2').join('');
                var oldStage = (oldStageId.trim()).split('-list2').join('');
                var fld = '{!groupByField}';
                var fldtype = '{!groupByFieldType}';
                
                var itemOldId = itemId;
                var itemNewId = (itemId.trim()).split('-'+oldStage).join('');
                $("."+itemId).attr("id",itemNewId+"-"+newStage);
                $("#"+itemNewId+"-"+newStage).removeClass(itemId);
                $("#"+itemNewId+"-"+newStage).addClass(itemNewId+"-"+newStage);
                $("#"+itemNewId+"-"+newStage).css("border-left", "6px solid "+statusBorderColor[stageNameByShortMap[newStage]]);
                
                // Save new stage to opportunity Record.
                NewOppDragDropContoller.changeOpportunityStage(itemNewId, containFldVauesMap[newStage], fld ,fldtype,function(result, event){
                    if(event.status){
                        $("#drop-alert").text($("#"+itemNewId+"-name").text()+" status changed to "+newStage);
                        $("#drop-alert").slideDown(1000, 'easeOutBounce').fadeOut(2500);
                    }else{
                        $("#drop-alert").text("Sorry," + $("#"+itemNewId+"-name").text()+" can not move forward");
                        $("#drop-alert").slideDown(1000, 'easeOutBounce').fadeOut(2500);    
                    }    
                });
            }
            
            function toggleFollowingOpportunity(oppRecordId, action, oppName){
                NewOppDragDropContoller.toggleFollowingOpportunity(oppRecordId, action, function(result, event){
                    if(event.status){
                        
                        var newAction = action == 'following' ? 'unfollowing' : 'following';
                        $("#"+oppRecordId+"-bookmark").attr("onclick","toggleFollowingOpportunity('"+oppRecordId+"','"+newAction+"','"+oppName+"');")
                        if(action == 'following'){
                            $("#"+oppRecordId+"-bookmark").removeClass('glyphicon-bookmark-black');
                            $("#"+oppRecordId+"-bookmark").addClass('glyphicon-bookmark-deepskyblue');
                            $("#"+oppRecordId+"-bookmark").attr('title', 'Stop following this opportunity to stop receiving updates in your feed.');
                            $("#drop-alert").text('You are now '+action+' '+oppName+' opportunity record.');
                        }
                        else{
                            $("#"+oppRecordId+"-bookmark").removeClass('glyphicon-bookmark-deepskyblue');
                            $("#"+oppRecordId+"-bookmark").addClass('glyphicon-bookmark-black');
                            $("#"+oppRecordId+"-bookmark").attr('title', 'Start Following this opportunity to receive updates in your feed.');
                            $("#drop-alert").text('You have stopped following '+oppName+' opportunity record.');
                        }
                        $("#drop-alert").slideDown(1500, 'easeOutBounce').fadeOut(2500);
                        
                    }    
                });
            }
            
