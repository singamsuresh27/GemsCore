            function editOpportunity(oppRecordId){
                $('#edit-opportunity-model').modal();
                var oppRecord = mapOpportunityRecords[oppRecordId];
               
                $("#edit-model-title").text(oppRecord.Name);
                $("#opportunity-name").val(oppRecord.Name);
                $("[id$='opportunity-account']").val(oppRecord.Account.Name);
                $("[id$='opportunity-account_lkid']").val(oppRecord.AccountId);
                $("[id*='opportunity-amount']").val('$ '+oppRecord.Amount);
                $("[id*='opportunity-stagename']").val(oppRecord.StageName);
                $("[id*='opportunity-type']").val(oppRecord.Type);
                $("#opportunity-ownername").text(oppRecord.Owner.Name);
                
                var d = new Date(oppRecord.CloseDate);
                $("#opportunity-closedate").val(d.getMonth()+'/'+d.getDate()+'/'+d.getFullYear());
                
                if((oppRecord.LeadSource !== undefined) && !($('option[value="'+oppRecord.LeadSource+'"]', '[id*="opportunity-leadsource"]').length)){
                    $('<option value="'+ oppRecord.LeadSource +'">'+oppRecord.LeadSource+'</option>').appendTo( $('[id*="opportunity-leadsource"]'));
                }
                $("[id*='opportunity-leadsource']").val(oppRecord.LeadSource);
                $("#opportunity-save-btn").attr('onclick','saveOpportunity(\''+oppRecordId+'\')')    
            }
            
            function saveOpportunity(oppRecordId){
                $('#edit-opportunity-model').modal();
                
