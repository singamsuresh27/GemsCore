<apex:page standardController="Quotation_Setra__c" extensions="CustomQuotePDFLayoutControllerEMEA" renderAs="pdf" showHeader="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" >
<html>
    <head>
    <style>
    #tableItem td, #table1 td{
        border: 1px solid black;
        }
        table {
        width:100%;
        font-size:12px;
        border-collapse: collapse;
        }
        
       #tableItem td{
        padding-left:2px;
        }
       @bottom-center {
                                     content: element(footer);
                               }
        .line {
            border-bottom: 2px solid blue;
            margin-top: 5px;
            width: 100%;
        }
        footer {
                               
                               text-align: center;
                               position: fixed;
                               left: 0;
                               bottom: 0;
                               width: 100%;
                               color: grey;
                      }
    </style>
        </head>
    <body>
        <apex:pageblock id="ContactList">
           <!-- Dibya starts -->
            <table>
                <tbody>
                     <tr><td>
                     <apex:image url="{!$Resource.GemsSetraLogoEMEA}" width="100" height="30"/>
                         </td>
                         </tr>
                    
                  
                </tbody>
            </table>
            <table>
                <tbody><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td></tr></tbody>
            </table>
            <table>
                <tbody>
                     <tr><td>
                     <apex:image url="{!$Resource.GemsSetraLogoEMEA1}" width="300" height="20"/>
                         </td>
                         <div class="line"></div>
                         <td align="right"><b>Gems Sensors and Controls</b> |<b>West Control Solutions</b>  <br/> The Hyde Business Park | Brighton, East Sussex BN2 4JU <br/>Telephone: +44 (0)1273 606271 | www.GemsSensors.com</td>
                    </tr>
                </tbody>
            </table>
            <!-- Dibya ends -->
            <br/>
            <table id="table1">
                <tbody>
                    <tr><td style="width:20%">Quotation Number </td><td style="width:40%">{!Quotation_Setra__c.QuoteNumber__c}</td><td style="width:20%">Created Date </td><td style="width:20%"><apex:outputText value="{0,date, MM'/'dd'/'yyyy}">
                    <apex:param value="{!TODAY()}" /> 
                    </apex:outputText></td></tr>
                </tbody>
            </table>
            <br/>
            <table id="table1">
                <tbody>
                <tr>
                    <td style="width:60%">
                        <div style="float:left;width:34%">
                            To :<br/>
                            Company Name :<br/>
                            Address :<br/>
                        </div>
                        <div>
                            {!Quotation_Setra__c.Contact__r.Name}<br/>
                            {!Quotation_Setra__c.Account__r.Name} <br/>
                            <span>
                            <span style="display:{!IF(Quotation_Setra__c.Account__r.BillingStreet != null, 'inline-block','none')};">
                                {!Quotation_Setra__c.Account__r.BillingStreet},
                            </span>
                            <span style="display:{!IF(Quotation_Setra__c.Account__r.BillingCity != null, 'inline-block','none')}">
                                {!Quotation_Setra__c.Account__r.BillingCity},
                            </span>
                            <span style="display:{!IF(Quotation_Setra__c.Account__r.BillingState != null, 'inline-block','none')}">
                                {!Quotation_Setra__c.Account__r.BillingState},
                            </span>
                            <span style="display:{!IF(Quotation_Setra__c.Account__r.BillingPostalCode != null, 'inline-block','none')}">
                                {!Quotation_Setra__c.Account__r.BillingPostalCode},
                            </span>
                            {!Quotation_Setra__c.Account__r.BillingCountry} <br/> 
                            </span>
                        </div>
                        
                    </td>  
                    <td style="width:40%">
                        <div style="float:left;width:40%">
                            Prepared By:<br/>
                            Phone:<br/>
                            Email:<br/>
                        </div>
                        <div>
                            {!Quotation_Setra__c.Owner.Name}<br/>
                            {!Quotation_Setra__c.Owner.Phone}<br/>
                            {!Quotation_Setra__c.Owner.Email}<br/>
                            
                        </div>
                    </td>
                </tr>
                </tbody>
            </table><br/>
            <table id="table1">
                <tbody>
                    <tr>
                    <td >Dear {!Quotation_Setra__c.Contact__r.FirstName},<br/>
                    Thank you for the opportunity to provide a quotation for Gems products.  We are pleased to offer the following:<br/>        
                    </td>
                    </tr>
                </tbody>                
            </table>
                <table id="tableItem" cellspacing="0" cellpadding="0">
                    <tbody>
                    <tr style="font-weight:bold"><td>Line #</td><td>Part Number# </td><td>Product Description </td><td>Lead Time</td><td>Currency</td><td>Unit Price</td><td>Quantity</td><td>Total</td></tr>
                           
                    <apex:repeat value="{!quoteLineItems}" var="lineitemObj" rendered="{!NOT(ISNULL(quoteLineItems))}">
                        <tr><td>{!lineitemObj.Name} </td>
                            <td>{!lineitemObj.JDE_Part_Number__c}</td>
                            <td>{!lineitemObj.Product_Description__c}</td>
                            <td>{!lineitemObj.LeadTime__c}</td>
                            <td><apex:outputField value="{!lineitemObj.CurrencyIsoCode}"/></td>
                            <td><apex:outputText value="{0,number,###,###,##0.00}"><apex:param value="{!lineitemObj.List_Price_Unit__c}"/></apex:outputText></td>
                         <!--   <td>
                            <div style="display:{!IF(lineitemObj.Surcharge__c != null, 'block','none')}">
                                ${!lineitemObj.Surcharge__c} 
                               
                            </div>
                            </td> -->
                            <td>{!lineitemObj.Quantity__c}</td>
                            <td><apex:outputText value="{0,number,###,###,##0.00}"><apex:param value="{!lineitemObj.NetPrice__c}"/></apex:outputText></td>
   
                        </tr>
                    </apex:repeat>
                    <tr><td colspan="7" style="text-align:right">Grand Total&nbsp;</td><td><apex:outputText value="{0,number,###,###,##0.00}"><apex:param value="{!Quotation_Setra__c.GrandTotal__c}"/></apex:outputText></td></tr>
                    <tr><td colspan="8"> &nbsp;</td></tr>               
                    <tr><td colspan="8">
                        <br/>
                         <b><u>Additional Notes:</u></b><br/>
                         1. Quote is valid for 30 days.<br/>
                         2. Lead times are subject to change and may be based on the qty order. The lead time quoted starts from when you receive order acknowledgment.<br/>
                         3. For Fast Processing please email purchase orders to <a href="mailto:enquiries@west-cs.com">enquiries@west-cs.com</a> if you already hold an account with us.<br/>
                         4. This quote and all purchases made pursuant to it or referencing the products or services identified are subject solely to our Terms and Conditions as they may be updated from time to time and are available <a href='https://www.gemssensors.com/docs/default-source/resource-files/terms-conditions/gems-terms-conditions.pdf'>here:</a> <br/>
                         5. Payment   {!Quotation_Setra__c.Payment__c}<br/>
                         6. Incoterms {!Quotation_Setra__c.Incoterms__c}
                        <br/>
                   </td></tr>
                
                </tbody>
            </table>
            <footer>
              <div class="line"></div>
               <p style= "font-size:12pt">
                   LEVEL | FLOW | PRESSURE | TEMPERATURE | SOLENOID VALVES
                </p>
                <p style= "font-size:9pt">
                    Gems Sensors and Controls and West Control Solutions are divisions of TGA Industries<br/>
                 VAT Registration No. GB 788 0888 59, company registration No. 06020956
                </p>
             
            </footer> 
         </apex:pageblock>
        
         </body>
   </html> 
</apex:page>