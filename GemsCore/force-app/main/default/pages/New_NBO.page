<apex:page standardController="NBO_Forms__c" extensions="Cont_NBO" action="{!RedirectToNewNBO}">
<apex:form >
    <div class="bPageTitle"><div class="ptBody secondaryPalette"><div class="content"><img src="/s.gif" alt="NBO Form" class="pageTitleIcon" title="NBO Form"><h1 class="pageType">&nbsp;<span class="titleSeparatingColon">:</span></h1><h2 class="pageDescription">&nbsp;NBO Form</h2><div class="blank">&nbsp;</div></div><div class="links"><a href="javascript:openPopupFocusEscapePounds(%27/help/doc/user_ed.jsp?loc=help&target=co_edit.htm&section=CustomObjects%27, %27Help%27, 700, 600, %27width=700,height=600,resizable=yes,toolbar=yes,status=no,scrollbars=yes,menubar=yes,directories=no,location=no,dependant=no%27, false, false);" title="Help for this Page (New Window)"><span class="helpLink">Help for this Page</span><img src="/s.gif" alt="Help" class="helpIcon" title="Help"></a></div></div><div class="ptBreadcrumb"></div></div>
    <apex:pageblock >
            <apex:pageBlockButtons >
                <apex:commandButton action="{!GoToNBOForm}" value="Continue"/>
                <apex:commandButton action="{!Cancel}" value="Cancel"/>
            </apex:pageBlockButtons>
            <apex:pageBlockSection title="NBO Type" columns="1">
                <apex:pageBlockSectionItem >
                    <apex:outputLabel value="Select Product Type"/>
                    <apex:selectList value="{!RecordTypeDevName}" size="1"  id="theNBOType">
                        <apex:selectOptions value="{!RecordTypeSelectList}"/>
                    </apex:selectList>
                </apex:pageBlockSectionItem>
            </apex:pageBlockSection>
    </apex:pageblock>
</apex:form>
</apex:page>