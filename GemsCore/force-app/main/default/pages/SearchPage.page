                                            <apex:outputPanel rendered="{!isPaperCredit}"> <td class="dataRow"> <apex:inputField value="{!mps.tempCaseDetail.Primary_Reason__c}"/></td> </apex:outputPanel>  
                                            <apex:outputPanel rendered="{!isPaperCredit}"> <td class="dataRow"> <apex:inputField value="{!mps.tempCaseDetail.Reason_Code__c}"/></td> </apex:outputPanel>  
                                            <apex:actionRegion >
                                                <apex:outputPanel rendered="true"> <td class="dataRow" align="center" ><span class="raclass" data-value="{!mps.RAStatus}"> {!if(mps.RAStatus == 'No', 'No', '')}
                                                    <apex:commandLink value="{!if(mps.RAStatus == 'Yes', 'Yes', '')}" rendered="{!if(mps.RAStatus == 'Yes',true, false)}" action="{!caseDetailsObject}" oncomplete="openRABox('open');" rerender="pbRA" >
                                                        <apex:param name="indexOfTableRow" value="{!mps.idx}" assignTo="{!selRecord}"/>
                                                    </apex:commandLink> &nbsp; </span></td> 
                                                </apex:outputPanel> 
                                            </apex:actionRegion>
                                            <td class="dataRow"><apex:outputField value="{!mps.orderObj.shipDate__c}"/></td> 
                                            <td style="background-color:#f2f3f3;">
                                                <apex:inputFile value="{!mps.attachment.Body}" fileName="{!mps.attachment.name}" contentType="{!mps.attachment.contentType}"></apex:inputFile>
                                            </td>
                                            <!-- <td class="dataRow" align="center">{!if(mps.RAStatus =='Yes',<a href="">Yes</a> , 'No')}</td> -->                           
                                        </tr> 
                                </apex:repeat>
                                <apex:variable value="{!ct+1}" var="ct"/>
                                </apex:repeat>
                            </table>
                            <br/>
                            <br/>
                            <apex:inputCheckbox value="{!isSpecialReturn}"/> &nbsp;&nbsp; Special Return Type <br/> <br/>
                            Reason for Return <br/>
                            <apex:inputTextarea rows="3" cols="150" value="{!tObj.Description}"/> <br/>
                            <br/> Internal Comment <br/>
                            <apex:inputTextarea rows="3" cols="150" value="{!internalcomment}"/>
                            <br/><br/>
                            
                            <table width="100%" border="0"  cellspacing="5" cellpadding="5" class="list"> 
                                <tr>Attachments</tr>
                                <tr class="headerRow">
                                    <apex:repeat value="{!atchList}" var="attachFirst">
                                        <td class="headerRow"> 
                                             Upload Image :&nbsp;&nbsp;&nbsp;&nbsp;
                                            <apex:inputFile value="{!attachFirst.Body}" fileName="{!attachFirst.name}" contentType="{!attachFirst.contentType}"></apex:inputFile> 
                                        </td>
                                    </apex:repeat>
                                </tr>
                            </table>
                            
                            <br/><br/><hr/>
                            Showing Page &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; {!pageNumber} of &nbsp;&nbsp;&nbsp;&nbsp; {!totalPages}  &nbsp;&nbsp;&nbsp;&nbsp;
                            <apex:commandLink value="First" action="{!first}" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <apex:commandLink value="Previous" action="{!previous}" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <apex:commandLink value="Next" action="{!PNext}" />&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            <apex:commandLink value="Last" action="{!last}" />
                            <br/><hr/>
                            
                        </apex:outputPanel>
                        
                        <apex:outputPanel rendered="{!if(modelList.size == 0,true , false)}">
                            <apex:outputLabel style="text-align:center;color:red;font-size:180%;font-weight:700;" value="No Record found for this criteria......!!!!!"></apex:outputLabel>
                        </apex:outputPanel>
                        
                    </apex:pageBlock>
                    <br/>
                    <div id="actionBtnDiv"> 
                        <table align="center">
                            <tr>
                                <td><apex:commandButton value="Approve" action="{!addCaseDetail}" status="pageStatus"/></td>
                                <td><apex:commandButton disabled="False" value="Approve and Send Email" action="{!approveAndSendEmail}" status="pageStatus" rendered="{!if(isValidUser == true && isPaperCredit == false ,true,false)}" /></td>

                                <td><apex:commandButton value="Cancel" action="{!cancelAction}" status="pageStatus"/></td>
                            </tr>
                        </table>
                    </div>
                </apex:outputPanel>
                
                <div id="divBox" style="background-color:silver;">
                    <apex:pageBlock >
                        Case Comment : <br/>
                        <apex:inputTextarea cols="100" rows="5" value="{!caseCommentBody}"/> <br/> <br/>
                        <apex:commandButton value="Add Case Comment" action="{!addCaseComment}"/> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        <apex:commandButton value="Close" onclick="openBox('close');return false;"/>
                    </apex:pageBlock>            
                </div>
                
                
                <div id="divRABox" style="background-color:silver;">
                    <apex:pageBlock id="pbRA">
                        <apex:pageBlockTable value="{!lstCaseDetail}" var="cd" id="pbtRA">
                            <apex:column headerValue="Name">
                                <a href="/{!cd.id}" target="_blank">{!cd.name}</a>
                            </apex:column>
                            <apex:column value="{!cd.Case__r.Type}"/>
                            <!--<apex:column headerValue="Customer Name">
                                <apex:outputField value="{!cd.Order_Shipment__r.Accountid__c}"/>                        
                            </apex:column>
                            <apex:column headerValue="Product">
                                <apex:outputField value="{!cd.Order_Shipment__r.Productid__c}"/>                        
                            </apex:column> --> 
                            <apex:column value="{!cd.Quantity__c}"/>
                            <apex:column value="{!cd.Credit_per_unit__c}"/>
                            <apex:column headerValue="Order & Shipment">
                                <a href="/{!cd.Order_Shipment__c}" target="_blank">{!cd.name}</a>
                            </apex:column>
                            <apex:column value="{!cd.Stage__c}"/>
                            <apex:column headerValue="Create Date">
                                <apex:outputField value="{!cd.createdDate}"/>                        
                            </apex:column>
                        </apex:pageBlockTable>
                    </apex:pageBlock>            
                </div>
        </apex:form>
    </div>
    <script>
        
        $(document).ready(function(){
            $(".raclass").each(function(){
                if($(this).attr("data-value") == "Yes"){
                    $(this).parent().parent().css("background", "yellow");
                }
            });
        });
        
    </script>
     
</apex:page>