    <apex:outputPanel id="jsonpanel">
        <script>
             var jsonData = '{!JSENCODE(contactJson)}';
             var jstr= '';
             if(jsonData != ''){
                 jstr = JSON.parse(jsonData);
             }else{
                 jstr = '';
             }
             function showjsonstr(){
            
                var htmlstr = '<select id="selcon" size="1" onchange="jselContactId();">';
                htmlstr += '<option value="n">--Select Contact--</option>';
                if('{!selcontact}' == 'new'){
                    htmlstr += '<option value="new" selected="true">--Create New Contact--</option>';
                }else{
                    htmlstr += '<option value="new">--Create New Contact--</option>';
                } 
                for(var i=0; i<jstr.length; i++){
                    var str = jstr[i].FirstName + ' ' + jstr[i].LastName + ' | ' + jstr[i].Phone + ' | ' + jstr[i].Email;
                    //alert('=====> {!selcontact} ');  
                    if(jstr[i].Id == '{!selcontact}'){
                        htmlstr += '<option value="' + jstr[i].Id + '" selected="true">' + str + '</option>';
                    }else{
                        htmlstr += '<option value="' + jstr[i].Id + '">' + str + '</option>';    
                    }
                }
                htmlstr +='</select>';
                console.log(htmlstr);
                //alert(htmlstr);
                document.getElementById('divJ').innerHTML = htmlstr;
        }   
        </script>
    </apex:outputPanel>
     <script>
         $(function(){
           var dlg = $( "#divBox" ).dialog({
               autoOpen:false,
               width:700,
               title:'Decline RA Request',
               height:300
           });
           var dlgRA = $( "#divRABox" ).dialog({
               autoOpen:false,
               width:900,
               title:'Case Detail Records',
               height:500
           });
           dlg.parent().appendTo("#pg\\:frm");
           dlgRA.parent().appendTo("#pg\\:frm");
           //showjsonstr();
        });
        function jselContactId(){
            var obj = document.getElementById('selcon');
            var sv = obj.options[obj.selectedIndex].value;
            //alert(sv);
            for(var i=0; i<obj.options.length; i++){
                if(obj.options[i].value == sv){
                    obj.options[i].selected = true;
                    break;
                }    
            }
            actSetConId(sv);
        }
        
        function openBox(st){
             $( "#divBox" ).dialog(st);
        }
        function openRABox(st){
            $( "#divRABox" ).dialog(st);
        }
        function openAndCloseModel(st){
            $("#AttachmentDiv").dialog(st);
        }
    </script>
